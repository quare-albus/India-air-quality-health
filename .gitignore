# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example

# Data: keep raw and large derived files out of Git
data/raw/**
!data/raw/.gitkeep
data/interim/**
!data/interim/.gitkeep
data/processed/**
!data/processed/.gitkeep
*.parquet
*.feather
*. DuckDB
*.duckdb
*.h5
*.hdf5
*.nc
*.grib
*.zarr/

# Outputs generated locally
outputs/figures/**
!outputs/figures/.gitkeep
outputs/tables/**
!outputs/tables/.gitkeep
outputs/reports/**
!outputs/reports/.gitkeep

# Notebooks
.ipynb_checkpoints/
